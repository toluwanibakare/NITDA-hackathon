# ── Env & secrets (never commit real credentials) ──
# Templates (*.example) are explicitly re-included below.
.env
.env.*
!.env.example
apps/*/.env*
!apps/*/.env.example
packages/*/.env*
!packages/*/.env.example
*.pem
*.key

# ── Node / npm ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.pnp
.pnp.js

# ── Build output ──
dist/
build/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ── Test / coverage ──
coverage/
.nyc_output/
junit.xml

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
*.egg-info/
.eggs/

# ── Supabase CLI (local state) ──
.supabase/
supabase/.branches/
supabase/.temp/

# ── OS / editors ──
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ── Demo / Scratch routes ──
apps/web/app/chatgpt


# ── Logs & local scratch ──
.agents/*
!.agents/skills/
.memory/
